{
  "name": "multer-dropbox",
  "version": "2.0.0",
  "description": "Dropbox Multer Storage Engine",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kisiwu/multer-dropbox.git"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "kaukau --import tsx --config kaukau.config.mjs",
    "test:watch": "kaukau --import tsx --config kaukau.config.mjs --watch kaukau.config.mjs --watch index.js --watch index.cjs"
  },
  "keywords": [
    "dropbox",
    "multer",
    "form",
    "post",
    "multipart",
    "form-data",
    "formdata",
    "express",
    "middleware"
  ],
  "author": "demingongo",
  "license": "MIT",
  "peerDependencies": {
    "dropbox": "^10.66.0"
  },
  "dependencies": {
    "run-parallel": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/chai": "^5.2.3",
    "@types/eslint-plugin-mocha": "^11.1.87",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.3.0",
    "@types/run-parallel": "^1.1.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "chai": "^6.3.0",
    "dropbox": "^10.66.0",
    "eslint": "^10.15.0",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.14.0",
    "kaukau": "^6.0.2",
    "multer": "^2.5.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
